# Railway Postgres (required for job.py)
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Public desk URL written into the email CTA
PUBLIC_URL=https://ten-themes.vercel.app

# Replay a specific session date (optional)
# ASOF=2026-08-14

# Weekly email (mailer.py). App Password from https://myaccount.google.com/apppasswords — does not expire.
GMAIL_APP_PASSWORD=
# MAIL_FROM=stuymusty@gmail.com
# MAIL_TO=stuymusty@gmail.com
# Alternative: Gmail API (needs OAuth consent screen in Production, else 7-day expiry)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Publish: job.py commits public/ to the site repo; Vercel (Git-connected) deploys main.
# Fine-grained token scoped to that repo only, Contents: read & write.
GITHUB_TOKEN=
# PUBLISH_REPO=skyspeak/industry
# PUBLISH_BRANCH=main
# PUBLISH_DIR=public
